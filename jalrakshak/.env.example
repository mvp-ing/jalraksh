# Jalrakshak Environment Variables
# Copy this file to .env and fill in your API keys

# Mapbox Access Token (required for map display)
MapboxAccessToken=your_mapbox_token_here

# Mapbox Export Token (for exporting maps)
MapboxExportToken=your_mapbox_export_token_here

# Google AI API Key (for AI Assistant with Gemini)
GoogleAIApiKey=your_google_ai_api_key_here

