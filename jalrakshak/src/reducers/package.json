{
  "name": "@jalrakshak/reducers",
  "version": "3.2.4",
  "description": "jalrakshak constants used by jalrakshak components, actions and reducers",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "babel",
    "es6",
    "react",
    "webgl",
    "visualization",
    "deck.gl"
  ],
  "scripts": {
    "build": "rm -fr dist && babel src --out-dir dist --source-maps inline --extensions '.ts,.tsx,.js,.jsx' --ignore '**/*.d.ts'",
    "build:umd": "NODE_OPTIONS=--openssl-legacy-provider webpack --config ./webpack/umd.js --progress --env.prod",
    "build:types": "tsc --project ./tsconfig.production.json",
    "prepublishOnly": "babel-node ../../scripts/license-header/bin --license ../../FILE-HEADER && yarn build && yarn build:types",
    "stab": "mkdir -p dist && touch dist/index.js"
  },
  "files": [
    "dist",
    "umd"
  ],
  "dependencies": {
    "@jalrakshak/actions": "3.2.4",
    "@jalrakshak/cloud-providers": "3.2.4",
    "@jalrakshak/common-utils": "3.2.4",
    "@jalrakshak/constants": "3.2.4",
    "@jalrakshak/deckgl-arrow-layers": "3.2.4",
    "@jalrakshak/deckgl-layers": "3.2.4",
    "@jalrakshak/effects": "3.2.4",
    "@jalrakshak/layers": "3.2.4",
    "@jalrakshak/processors": "3.2.4",
    "@jalrakshak/schemas": "3.2.4",
    "@jalrakshak/table": "3.2.4",
    "@jalrakshak/tasks": "3.2.4",
    "@jalrakshak/types": "3.2.4",
    "@jalrakshak/utils": "3.2.4",
    "@loaders.gl/loader-utils": "^4.3.2",
    "@mapbox/geo-viewport": "^0.4.1",
    "@math.gl/web-mercator": "^3.6.2",
    "@turf/bbox": "^6.0.1",
    "@turf/bbox-polygon": "^6.0.1",
    "@turf/boolean-within": "^6.0.1",
    "@types/lodash": "4.17.5",
    "@types/redux-actions": "^2.6.2",
    "copy-to-clipboard": "^3.3.1",
    "d3-color": "^2.0.0",
    "d3-dsv": "^2.0.0",
    "deepmerge": "^4.2.2",
    "global": "^4.3.0",
    "lodash": "4.17.21",
    "react-palm": "^3.3.8",
    "redux": "^4.2.1",
    "redux-actions": "^2.2.1",
    "reselect": "^4.1.0",
    "@jalrakshak/localization": "3.2.4"
  },
  "nyc": {
    "sourceMap": false,
    "instrument": false
  },
  "engines": {
    "node": ">=18"
  },
  "volta": {
    "node": "18.18.2"
  }
}